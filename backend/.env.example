# MarketPulse Express/Node Backend Environment Variables
# Render sets PORT automatically (defaults to 10000 on Render)
PORT=8000
NODE_ENV=production

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access, add IP "0.0.0.0/0" (Allow Access from Anywhere)
# because Render assigns dynamic cloud IP addresses.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=stocktracker

# JWT Authentication Secret Key (use a long random string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Optional: Groq LLM API Key for AI features (Chart reader, news impact, portfolio diagnosis)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
