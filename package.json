{
  "name": "proximity-stocktracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "server": "npm --prefix backend start",
    "server:dev": "npm --prefix backend run dev",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "client": "npm --prefix frontend run dev",
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build && node -e \"const fs=require('fs'); try{fs.cpSync('frontend/dist','dist',{recursive:true});}catch(e){}\"",
    "start": "node backend/src/index.js",
    "test": "node backend/test-server.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "groq-sdk": "^0.15.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "yahoo-finance2": "^2.13.3"
  }
}
