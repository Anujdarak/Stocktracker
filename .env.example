# MarketPulse Environment Variables Reference
# ============================================

# Backend Environment Variables (configured in Render Dashboard -> Environment):
PORT=10000
NODE_ENV=production
# In MongoDB Atlas -> Network Access, add IP "0.0.0.0/0"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=stocktracker
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Frontend Environment Variables (configured in Vercel Project Settings -> Environment Variables):
# Point this to your live Render backend URL with /api:
VITE_API_URL=https://<your-render-backend-name>.onrender.com/api
